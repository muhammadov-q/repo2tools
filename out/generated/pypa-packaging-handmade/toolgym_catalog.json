{
 "mcp_server": {
  "name": "repo2tools_pypa_packaging_handmade",
  "repo": "repo2tools/pypa-packaging-handmade",
  "tools": [
   {
    "mcp_spec": {
     "name": "is_valid_version",
     "description": "Check whether a string is a valid version under Python's version rules (PEP 440).",
     "inputSchema": {
      "properties": {
       "version": {
        "title": "Version",
        "type": "string"
       }
      },
      "required": [
       "version"
      ],
      "title": "is_valid_versionArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "version": "IsValidVersionVersion"
     },
     "output_type": "boolean"
    }
   },
   {
    "mcp_spec": {
     "name": "normalize_version",
     "description": "Return the normalized PEP 440 form of a version string, e.g. '1.0-BETA2' -> '1.0b2'.",
     "inputSchema": {
      "properties": {
       "version": {
        "title": "Version",
        "type": "string"
       }
      },
      "required": [
       "version"
      ],
      "title": "normalize_versionArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "version": "VersionStringX"
     },
     "output_type": "VersionStringX"
    }
   },
   {
    "mcp_spec": {
     "name": "version_info",
     "description": "Split a PEP 440 version into its parts: epoch, release numbers, pre-, post- and\ndev-release, local label, public and base version, and whether it is a pre-, post- or\ndev-release.",
     "inputSchema": {
      "properties": {
       "version": {
        "title": "Version",
        "type": "string"
       }
      },
      "required": [
       "version"
      ],
      "title": "version_infoArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "version": "VersionStringX"
     },
     "output_type": "object"
    }
   },
   {
    "mcp_spec": {
     "name": "base_version",
     "description": "Return the base version: the epoch and release numbers only, without pre-, post-,\ndev-release or local parts, e.g. '1!2.0rc1.post3+abc' -> '1!2.0'.",
     "inputSchema": {
      "properties": {
       "version": {
        "title": "Version",
        "type": "string"
       }
      },
      "required": [
       "version"
      ],
      "title": "base_versionArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "version": "VersionStringX"
     },
     "output_type": "VersionStringX"
    }
   },
   {
    "mcp_spec": {
     "name": "compare_versions",
     "description": "Compare two PEP 440 versions. Returns -1 if version_a is older, 0 if they are equal,\n1 if version_a is newer.",
     "inputSchema": {
      "properties": {
       "version_a": {
        "title": "Version A",
        "type": "string"
       },
       "version_b": {
        "title": "Version B",
        "type": "string"
       }
      },
      "required": [
       "version_a",
       "version_b"
      ],
      "title": "compare_versionsArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "version_a": "VersionStringX",
      "version_b": "VersionStringX"
     },
     "output_type": "integer"
    }
   },
   {
    "mcp_spec": {
     "name": "sort_versions",
     "description": "Sort version strings from oldest to newest (or newest first if descending is true),\nusing PEP 440 ordering. The strings are returned unchanged.",
     "inputSchema": {
      "properties": {
       "versions": {
        "items": {
         "type": "string"
        },
        "title": "Versions",
        "type": "array"
       },
       "descending": {
        "default": false,
        "title": "Descending",
        "type": "boolean"
       }
      },
      "required": [
       "versions"
      ],
      "title": "sort_versionsArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "versions": "VersionStringList",
      "descending": "SortVersionsDescending"
     },
     "output_type": "VersionStringList"
    }
   },
   {
    "mcp_spec": {
     "name": "canonicalize_version",
     "description": "Return the canonical form of a version used for comparing file names: normalized and,\nby default, without trailing '.0' release segments, e.g. '1.0.0' -> '1'.",
     "inputSchema": {
      "properties": {
       "version": {
        "title": "Version",
        "type": "string"
       }
      },
      "required": [
       "version"
      ],
      "title": "canonicalize_versionArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "version": "VersionStringX"
     },
     "output_type": "VersionStringX"
    }
   },
   {
    "mcp_spec": {
     "name": "is_valid_specifier",
     "description": "Check whether a string is a valid version constraint (specifier set), e.g. '>=1.0,<2'.",
     "inputSchema": {
      "properties": {
       "specifier": {
        "title": "Specifier",
        "type": "string"
       }
      },
      "required": [
       "specifier"
      ],
      "title": "is_valid_specifierArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "specifier": "SpecifierString"
     },
     "output_type": "boolean"
    }
   },
   {
    "mcp_spec": {
     "name": "version_satisfies",
     "description": "Check whether a version is allowed by a version constraint such as '>=1.0,!=1.3,<2'.\ninclude_prereleases: true allows pre-releases, false excludes them, null (default) follows\nPEP 440: pre-releases match only if the constraint itself mentions one.",
     "inputSchema": {
      "properties": {
       "version": {
        "title": "Version",
        "type": "string"
       },
       "specifier": {
        "title": "Specifier",
        "type": "string"
       },
       "include_prereleases": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Include Prereleases"
       }
      },
      "required": [
       "version",
       "specifier"
      ],
      "title": "version_satisfiesArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "version": "VersionStringX",
      "specifier": "SpecifierString",
      "include_prereleases": "VersionSatisfiesIncludePrereleases"
     },
     "output_type": "boolean"
    }
   },
   {
    "mcp_spec": {
     "name": "filter_versions",
     "description": "Keep only the versions allowed by a version constraint, in their original order.\ninclude_prereleases: true keeps pre-releases, false drops them, null (default) follows\nPEP 440: pre-releases are kept only if nothing else matches or the constraint mentions one.",
     "inputSchema": {
      "properties": {
       "versions": {
        "items": {
         "type": "string"
        },
        "title": "Versions",
        "type": "array"
       },
       "specifier": {
        "title": "Specifier",
        "type": "string"
       },
       "include_prereleases": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Include Prereleases"
       }
      },
      "required": [
       "versions",
       "specifier"
      ],
      "title": "filter_versionsArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "versions": "FilterVersionsVersions",
      "specifier": "SpecifierString",
      "include_prereleases": "FilterVersionsIncludePrereleases"
     },
     "output_type": "VersionStringList"
    }
   },
   {
    "mcp_spec": {
     "name": "combine_specifiers",
     "description": "Combine two version constraints into one that requires both, e.g. '>=1.0' and '<2' ->\n'<2,>=1.0'.",
     "inputSchema": {
      "properties": {
       "specifier_a": {
        "title": "Specifier A",
        "type": "string"
       },
       "specifier_b": {
        "title": "Specifier B",
        "type": "string"
       }
      },
      "required": [
       "specifier_a",
       "specifier_b"
      ],
      "title": "combine_specifiersArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "specifier_a": "SpecifierString",
      "specifier_b": "SpecifierString"
     },
     "output_type": "SpecifierString"
    }
   },
   {
    "mcp_spec": {
     "name": "is_satisfiable",
     "description": "Check whether at least one version could satisfy a version constraint, e.g.\n'>=2,<1' cannot.",
     "inputSchema": {
      "properties": {
       "specifier": {
        "title": "Specifier",
        "type": "string"
       }
      },
      "required": [
       "specifier"
      ],
      "title": "is_satisfiableArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "specifier": "SpecifierString"
     },
     "output_type": "boolean"
    }
   },
   {
    "mcp_spec": {
     "name": "specifier_is_subset",
     "description": "Check whether every version allowed by `specifier` is also allowed by `other`, e.g.\n'>=3.12,<3.13' is a subset of '>=3.12'.",
     "inputSchema": {
      "properties": {
       "specifier": {
        "title": "Specifier",
        "type": "string"
       },
       "other": {
        "title": "Other",
        "type": "string"
       },
       "include_prereleases": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Include Prereleases"
       }
      },
      "required": [
       "specifier",
       "other"
      ],
      "title": "specifier_is_subsetArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "specifier": "SpecifierString",
      "other": "SpecifierString",
      "include_prereleases": "SpecifierIsSubsetIncludePrereleases"
     },
     "output_type": "boolean"
    }
   },
   {
    "mcp_spec": {
     "name": "specifiers_overlap",
     "description": "Check whether at least one version is allowed by both version constraints.",
     "inputSchema": {
      "properties": {
       "specifier_a": {
        "title": "Specifier A",
        "type": "string"
       },
       "specifier_b": {
        "title": "Specifier B",
        "type": "string"
       }
      },
      "required": [
       "specifier_a",
       "specifier_b"
      ],
      "title": "specifiers_overlapArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "specifier_a": "SpecifierString",
      "specifier_b": "SpecifierString"
     },
     "output_type": "boolean"
    }
   },
   {
    "mcp_spec": {
     "name": "parse_requirement",
     "description": "Parse a dependency line such as 'requests[socks]>=2.31; python_version < \"3.13\"' into\nits name, extras, version constraint, environment marker and URL.",
     "inputSchema": {
      "properties": {
       "requirement": {
        "title": "Requirement",
        "type": "string"
       }
      },
      "required": [
       "requirement"
      ],
      "title": "parse_requirementArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "requirement": "ParseRequirementRequirement"
     },
     "output_type": "ParseRequirementOutput"
    }
   },
   {
    "mcp_spec": {
     "name": "evaluate_marker",
     "description": "Evaluate an environment marker such as 'python_version < \"3.11\" and sys_platform ==\n\"win32\"'. environment maps marker variables (python_version, sys_platform, os_name,\nplatform_machine, extra, ...) to values; variables not given are those of CPython 3.12.0\non Linux x86_64.",
     "inputSchema": {
      "properties": {
       "marker": {
        "title": "Marker",
        "type": "string"
       },
       "environment": {
        "anyOf": [
         {
          "additionalProperties": true,
          "type": "object"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Environment"
       }
      },
      "required": [
       "marker"
      ],
      "title": "evaluate_markerArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "marker": "MarkerString",
      "environment": "EvaluateMarkerEnvironment"
     },
     "output_type": "boolean"
    }
   },
   {
    "mcp_spec": {
     "name": "canonicalize_name",
     "description": "Return the normalized project name used by package indexes, e.g. 'Typing_Extensions' ->\n'typing-extensions'.",
     "inputSchema": {
      "properties": {
       "name": {
        "title": "Name",
        "type": "string"
       }
      },
      "required": [
       "name"
      ],
      "title": "canonicalize_nameArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "name": "CanonicalizeNameName"
     },
     "output_type": "string"
    }
   },
   {
    "mcp_spec": {
     "name": "parse_wheel_filename",
     "description": "Parse a wheel file name such as 'numpy-2.1.0-cp312-cp312-manylinux_2_17_x86_64.whl'\ninto project name, version, build tag and the set of compatibility tags it declares.",
     "inputSchema": {
      "properties": {
       "filename": {
        "title": "Filename",
        "type": "string"
       }
      },
      "required": [
       "filename"
      ],
      "title": "parse_wheel_filenameArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "filename": "WheelFilenameXX"
     },
     "output_type": "ParseWheelFilenameOutputX"
    }
   },
   {
    "mcp_spec": {
     "name": "parse_sdist_filename",
     "description": "Parse a source distribution file name such as 'requests-2.31.0.tar.gz' into project name\nand version.",
     "inputSchema": {
      "properties": {
       "filename": {
        "title": "Filename",
        "type": "string"
       }
      },
      "required": [
       "filename"
      ],
      "title": "parse_sdist_filenameArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "filename": "SdistFilenameXX"
     },
     "output_type": "object"
    }
   },
   {
    "mcp_spec": {
     "name": "parse_tag",
     "description": "Expand a compressed compatibility tag such as 'py2.py3-none-any' into the individual\ntags it stands for.",
     "inputSchema": {
      "properties": {
       "tag": {
        "title": "Tag",
        "type": "string"
       }
      },
      "required": [
       "tag"
      ],
      "title": "parse_tagArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "tag": "TagString"
     },
     "output_type": "TagStringList"
    }
   },
   {
    "mcp_spec": {
     "name": "supported_tags",
     "description": "List the wheel tags a CPython interpreter accepts, most preferred first.\npython_version is like '3.12'; platforms are platform tags such as\n['manylinux_2_17_x86_64', 'linux_x86_64'], most preferred first.",
     "inputSchema": {
      "properties": {
       "python_version": {
        "title": "Python Version",
        "type": "string"
       },
       "platforms": {
        "items": {
         "type": "string"
        },
        "title": "Platforms",
        "type": "array"
       }
      },
      "required": [
       "python_version",
       "platforms"
      ],
      "title": "supported_tagsArguments",
      "type": "object"
     }
    },
    "gym_types": {
     "parameters": {
      "python_version": "SupportedTagsPythonVersion",
      "platforms": "SupportedTagsPlatforms"
     },
     "output_type": "TagStringList"
    }
   }
  ]
 },
